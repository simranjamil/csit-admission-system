generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model AdmissionSession {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  year      Int      @unique
  status    String   @default("DRAFT") // DRAFT | ACTIVE | CLOSED
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")

  sessionPrograms SessionProgram[]
  applications   Application[]
  importJobs     ImportJob[]
  workflowStages WorkflowStage[]
  rules Rule[]


  @@map("admission_sessions")
}


model Program {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")


  timings ProgramTiming[]


  @@map("programs")
}


model ProgramTiming {
  id        Int     @id @default(autoincrement())
  programId Int     @map("program_id")
  timing    String // Evening | Weekend (future: Morning etc.)
  isActive  Boolean @default(true) @map("is_active")


  program         Program          @relation(fields: [programId], references: [id])
  sessionPrograms SessionProgram[]
    applications Application[]



  @@unique([programId, timing])
  @@map("program_timings")
}


model SessionProgram {
  id              Int     @id @default(autoincrement())
  sessionId       Int     @map("session_id")
  programTimingId Int     @map("program_timing_id")
  seats           Int     @default(0)
  rollPrefix      String? @map("roll_prefix")


  session       AdmissionSession @relation(fields: [sessionId], references: [id])
  programTiming ProgramTiming    @relation(fields: [programTimingId], references: [id])


  @@unique([sessionId, programTimingId])
  @@map("session_programs")
}



model Module {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  permissions Permission[]
 
  @@map("modules")
}
 
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
 
  userRoles UserRole[]
  auditLogs AuditLog[]
  importJobs         ImportJob[]
  admissionDecisions AdmissionDecision[]
  ruleVersions RuleVersion[]

 
  @@map("users")
}
 
model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  homePath    String  @default("/") @map("home_path")
 
  userRoles       UserRole[]
  rolePermissions RolePermission[]
 
  @@map("roles")
}
 
model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
 
  @@id([userId, roleId])
  @@map("user_roles")
}
 
model Permission {
  id          Int     @id @default(autoincrement())
  moduleId    Int     @map("module_id")
  code        String  @unique
  description String?
 
  module          Module           @relation(fields: [moduleId], references: [id])
  rolePermissions RolePermission[]
 
  @@map("permissions")
}
 
model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")
 
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
 
  @@id([roleId, permissionId])
  @@map("role_permissions")
}
 
model Session {
  sid       String   @id
  data      String
  expiresAt DateTime @map("expires_at")
 
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    Int?     @map("entity_id")
  description String
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
 
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
 
  @@index([createdAt])
  @@map("audit_logs")
}

model Student {
  id         Int      @id @default(autoincrement())
  cnic       String?  @unique
  passport   String?  @unique
  name       String
  fatherName String?  @map("father_name")
  gender     String?
  mobile     String?
  email      String?
  isDummy    Boolean  @default(false) @map("is_dummy")
  createdAt  DateTime @default(now()) @map("created_at")
 
  applications Application[]
 
  @@map("students")
}
 
model Application {
  id                Int      @id @default(autoincrement())
  sessionId         Int      @map("session_id")
  studentId         Int      @map("student_id")
  programTimingId   Int?     @map("program_timing_id")
  formNo            String?  @map("form_no")
  rollNo            String?  @map("roll_no")
  originalRollNo    String?  @map("original_roll_no")
  externalStudentId String?  @map("external_student_id")
  degreeTitle       String?  @map("degree_title")
  uniName           String?  @map("uni_name")
  passingYear       Int?     @map("passing_year")
  obtainedMarks     Decimal? @map("obtained_marks") @db.Decimal(10, 3)
  totalMarks        Decimal? @map("total_marks") @db.Decimal(10, 3)
  cgpa              Decimal? @db.Decimal(5, 3)
  extraData         Json?    @map("extra_data")
  isDummy           Boolean  @default(false) @map("is_dummy")
  status            String   @default("APPLIED")
  createdAt         DateTime @default(now()) @map("created_at")
 
  session       AdmissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programTiming ProgramTiming?   @relation(fields: [programTimingId], references: [id])
 
  eligibilityEvaluations EligibilityEvaluation[]
  testAttempts           TestAttempt[]
  admissionDecision      AdmissionDecision?
 
  @@unique([sessionId, rollNo])
  @@unique([sessionId, studentId, programTimingId])
  @@index([sessionId])
  @@map("applications")
}
 
model EligibilityEvaluation {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  decision      String   // ELIGIBLE | INELIGIBLE
  reason        String?
  evaluatedAt   DateTime @default(now()) @map("evaluated_at")
  ruleVersionId Int? @map("rule_version_id")
  ruleVersion RuleVersion? @relation(fields: [ruleVersionId], references: [id], onDelete: SetNull)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
 
  @@index([applicationId])
  @@map("eligibility_evaluations")
  @@index([ruleVersionId])
}
 
model TestAttempt {
  id              Int       @id @default(autoincrement())
  applicationId   Int       @map("application_id")
  obtainedMarks   Float     @map("obtained_marks")
  totalMarks      Float     @map("total_marks")
  percentage      Float
  durationSeconds Int?      @map("duration_seconds")
  takenAt         DateTime? @map("taken_at")
  result          String    // PASSED | FAILED
  createdAt       DateTime  @default(now()) @map("created_at")
  ruleVersionId Int? @map("rule_version_id")
  ruleVersion RuleVersion? @relation(fields: [ruleVersionId], references: [id], onDelete: SetNull)
 

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

 
  @@index([applicationId])
   @@index([ruleVersionId])
  @@map("test_attempts")
  
}
 
model AdmissionDecision {
  id            Int       @id @default(autoincrement())
  applicationId Int       @unique @map("application_id")
  status        String    @default("PENDING") // PENDING | ADMITTED | REJECTED | WAITLISTED
  decidedById   Int?      @map("decided_by")
  reason        String?
  decidedAt     DateTime? @map("decided_at")
 
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decidedBy   User?       @relation(fields: [decidedById], references: [id])
 
  @@map("admission_decisions")
}
 
model ImportJob {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  sourceType  String   @map("source_type") // STUDENTS | RESULTS
  fileName    String   @map("file_name")
  rowCount    Int      @default(0) @map("row_count")
  status      String   @default("PENDING")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
 
  session   AdmissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
 
  @@index([sessionId])
  @@map("import_jobs")
}
 
model WorkflowStage {
  id          Int       @id @default(autoincrement())
  sessionId   Int       @map("session_id")
  stageCode   String    @map("stage_code") // IMPORT | ELIGIBILITY | RESULTS | INTERVIEWS | MERIT | ADMISSION
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  completedAt DateTime? @map("completed_at")
 
  session AdmissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
 
  @@unique([sessionId, stageCode])
  @@map("workflow_stages")
}


model Rule {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  ruleKey   String   @map("rule_key") // MIN_CGPA | TEST_PASS | MERIT_WEIGHTS | INTERVIEW_SLOT
  createdAt DateTime @default(now()) @map("created_at")


  session  AdmissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  versions RuleVersion[]


  @@unique([sessionId, ruleKey])
  @@map("rules")
}


model RuleVersion {
  id            Int      @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  version       Int
  config        Json
  reason        String?
  effectiveFrom DateTime @default(now()) @map("effective_from")
  approvedById  Int?     @map("approved_by")


  rule       Rule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  approvedBy User? @relation(fields: [approvedById], references: [id], onDelete: SetNull)


  eligibilityEvaluations EligibilityEvaluation[]
  testAttempts           TestAttempt[]


  @@unique([ruleId, version])
  @@map("rule_versions")
}
